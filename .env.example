# Copia este archivo como .env y cambia los valores. El .env no se sube a git.
FINANZAS_USER=tu-usuario
FINANZAS_PASSWORD=tu-contrasena

# Opcionales
# FINANZAS_DB=finanzas.db       ruta de la base SQLite
# FINANZAS_HOST=0.0.0.0         para abrirla desde el celular en la misma WiFi

# Solo para deploy.ps1
# FINANZAS_DEPLOY_HOST=root@tu.servidor
# FINANZAS_DEPLOY_KEY=C:/ruta/a/tu/llave_ed25519
